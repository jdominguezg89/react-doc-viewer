{
  "name": "@cyntler/react-doc-viewer",
  "version": "1.17.1",
  "description": "File viewer for React.",
  "author": "Matthew Mogford / Damian Cyntler",
  "type": "module",
  "keywords": [
    "reactjs",
    "react-library",
    "file-viewer",
    "doc-viewer"
  ],
  "license": "Apache-2.0",
  "homepage": "https://cyntler.github.io/react-doc-viewer",
  "repository": {
    "url": "https://github.com/cyntler/react-doc-viewer"
  },
  "files": [
    "dist/**"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/react-doc-viewer.cjs",
  "module": "./dist/react-doc-viewer.js",
  "exports": {
    ".": {
      "import": "./dist/react-doc-viewer.js",
      "require": "./dist/react-doc-viewer.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    }
  },
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "rm -rf dist && tsc && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "storybook:build": "rm -rf storybook-static && storybook build",
    "deploy": "pnpm run storybook:build && gh-pages --nojekyll -d storybook-static --message \"feat: storybook deploy\"",
    "prerelease": "pnpm run check && pnpm run test && pnpm run build",
    "release": "release-it && pnpm run deploy",
    "build-readme-toc": "npx doctoc README.md --title \"## Table of Contents\""
  },
  "dependencies": {
    "core-js": "^3.37.1",
    "mustache": "^4.2.0",
    "papaparse": "^5.4.1",
    "react-pdf": "^9.0.0",
    "styled-components": "^6.1.11"
  },
  "devDependencies": {
    "@rollup/plugin-dsv": "^3.0.4",
    "@storybook/addon-essentials": "^8.1.5",
    "@storybook/addon-interactions": "^8.1.5",
    "@storybook/addon-links": "^8.1.5",
    "@storybook/react": "^8.1.5",
    "@storybook/react-vite": "^8.1.5",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "gh-pages": "^6.1.1",
    "happy-dom": "^14.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "release-it": "^17.3.0",
    "storybook": "^8.1.5",
    "typescript": "7.0.2",
    "vite": "^5.2.12",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^1.6.0",
    "vitest-fetch-mock": "^0.2.2",
    "@types/mustache": "^4.2.6",
    "@types/papaparse": "^5.5.2",
    "@biomejs/biome": "2.5.15"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
