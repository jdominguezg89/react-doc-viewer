{
  "name": "@cyntler/react-doc-viewer",
  "version": "1.17.1",
  "description": "File viewer for React.",
  "author": "Matthew Mogford / Damian Cyntler",
  "type": "module",
  "keywords": [
    "reactjs",
    "react-library",
    "file-viewer",
    "doc-viewer"
  ],
  "license": "Apache-2.0",
  "homepage": "https://cyntler.github.io/react-doc-viewer",
  "repository": {
    "url": "https://github.com/cyntler/react-doc-viewer"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "rm -rf dist && tsc && vite build && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs && node scripts/verify-dist.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "storybook:build": "rm -rf storybook-static && storybook build",
    "deploy": "pnpm run storybook:build && gh-pages --nojekyll -d storybook-static --message \"feat: storybook deploy\"",
    "prerelease": "pnpm run check && pnpm run test && pnpm run build",
    "release": "release-it && pnpm run deploy",
    "build-readme-toc": "npx doctoc README.md --title \"## Table of Contents\"",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "mustache": "^4.2.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.3.289",
    "react-pdf": "11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "release-it": "^21.1.0",
    "storybook": "^10.6.1",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vitest-fetch-mock": "^0.4.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "sideEffects": [
    "**/*.css"
  ]
}
