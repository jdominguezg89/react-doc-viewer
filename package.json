{
  "name": "@jdominguezg89/react-doc-viewer",
  "version": "2.0.2",
  "description": "File viewer for React: PDF, images, CSV, text, HTML, video and Office documents.",
  "author": "jdominguezg89 (https://github.com/jdominguezg89)",
  "contributors": [
    "Matthew Mogford",
    "Damian Cyntler"
  ],
  "type": "module",
  "keywords": [
    "react",
    "react-19",
    "file-viewer",
    "doc-viewer",
    "pdf-viewer",
    "document-viewer",
    "nextjs"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/jdominguezg89/react-doc-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdominguezg89/react-doc-viewer.git"
  },
  "files": [
    "dist",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/index.css": {
      "types": "./dist/index.css.d.ts",
      "default": "./dist/index.css"
    },
    "./dist/pdf.worker.min.mjs": "./dist/pdf.worker.min.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "rm -rf dist && tsc && vite build && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs && node scripts/verify-dist.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "storybook:build": "rm -rf storybook-static && storybook build",
    "example:nextjs:build": "pnpm build && pnpm --filter react-doc-viewer-nextjs-example build",
    "prepack": "pnpm run build",
    "sync:pdfjs": "node scripts/sync-pdfjs.mjs"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.3.289",
    "react-pdf": "11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-fetch-mock": "^0.4.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "sideEffects": [
    "**/*.css"
  ],
  "bugs": {
    "url": "https://github.com/jdominguezg89/react-doc-viewer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
