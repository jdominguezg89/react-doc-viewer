{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 8am on monday"],
  "timezone": "Europe/Stockholm",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Must match react-pdf's pin; run `pnpm sync:pdfjs` instead.",
      "matchPackageNames": ["pdfjs-dist"],
      "enabled": false
    },
    {
      "description": "Runtime dependencies ship to consumers: release a patch for them.",
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "fix"
    },
    {
      "description": "One PR for all dev tooling minor and patch updates.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies"
    },
    {
      "matchPackageNames": ["storybook", "@storybook/**"],
      "groupName": "storybook"
    },
    {
      "description": "The Next.js example is not published; keep its updates together.",
      "matchFileNames": ["use-cases/**"],
      "matchPackageNames": ["next"],
      "groupName": "nextjs example",
      "labels": ["example"]
    },
    {
      "description": "Biome and its biome.json schema URL must move together, in one PR for every update type.",
      "matchPackageNames": ["@biomejs/biome"],
      "groupName": "biome"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the $schema URL in biome.json on the installed Biome version (Biome rejects a mismatch).",
      "managerFilePatterns": ["/^biome\\.json$/"],
      "matchStrings": [
        "\"\\$schema\":\\s*\"https://biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json\""
      ],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    }
  ]
}
